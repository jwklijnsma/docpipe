# Settings for the docpipe container. One KEY=value per line; comments on their own line.

# Access token for the web UI, for the Docker service only: uncomment and set it. The Podman units
# take it from the Podman secret `docpipe-token` instead (install.sh creates it).
# Generate one with: openssl rand -hex 24  (hex: a "+" would break the ?token= link)
#DOCPIPE_WEB_TOKEN=

# Your Ollama server(s), comma-separated. On this host it must listen on more than
# 127.0.0.1 (systemctl edit ollama -> Environment=OLLAMA_HOST=0.0.0.0).
DOCPIPE_OLLAMA_URL=http://host.containers.internal:11434

# Default model; it can also be picked in the web UI (top bar), which wins.
#DOCPIPE_MODEL=qwen2.5:14b
